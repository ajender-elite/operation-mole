{
  "name": "om",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @om/server dev\" \"pnpm --filter @om/web dev\"",
    "build": "pnpm --filter @om/web build",
    "start": "pnpm --filter @om/server start",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:remote": "vitest run --config apps/server/vitest.remote.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "postinstall": "node scripts/ensure-example-dirs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
