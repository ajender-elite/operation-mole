# Environment variables the OM server reads (validated in apps/server/src/config/server-config.ts).
# All are optional. OM does not load .env files; set these in your shell or process manager.

# API port. Not PORT: the preview runner sets PORT for the web app.
API_PORT=5181
# Interface to bind. OM can read your files, so keep it on loopback unless you know why not.
HOST=127.0.0.1
# Sessions, cloned repos and the database (default: <repo>/.data).
OM_DATA_DIR=
# Limits, enforced on the server (creating past one answers 409).
OM_MAX_SESSIONS_PER_USER=10
OM_MAX_REPOS_PER_SESSION=10
OM_MAX_REMOTES_PER_REPO=10
# Analysis cache per user, in megabytes (least recently used results go first).
OM_CACHE_MAX_MB=256
